{
  "name": "quickdraw-chat",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "scripts/load-env.sh turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "turbo typecheck",
    "check": "turbo lint typecheck",
    "test": "turbo test",
    "test:unit": "turbo test:unit",
    "test:int": "turbo test:int",
    "test:watch": "turbo test:watch",
    "test:coverage": "turbo test:coverage",
    "reset:dev": "bash scripts/reset-dev.sh",
    "db:generate": "turbo db:generate",
    "db:push": "turbo db:push",
    "db:migrate": "turbo db:migrate",
    "db:seed": "turbo db:seed",
    "docs:generate": "tsx scripts/generate-docs.ts",
    "bench:netcode": "turbo build --filter=@project/shared --filter=@project/bench && bun run --cwd apps/api bench:netcode",
    "bench:server": "turbo build --filter=@project/shared --filter=@project/bench && bun run --cwd apps/api bench:server",
    "bench:compare": "tsx packages/bench/src/cli/compare.ts",
    "build:prod": "NODE_ENV=production turbo build",
    "db:migrate:deploy": "cd packages/db && bun run db:migrate:deploy",
    "prepare": "husky && conveyor-skills link"
  },
  "devDependencies": {
    "@fitzzero/quickdraw-core": "^4.1.0",
    "@rallycry/conveyor-skills": "^1.0.0",
    "@types/node": "^24.0.0",
    "@typescript/native-preview": "^7.0.0-dev",
    "dotenv-cli": "^11.0.0",
    "husky": "^9.0.0",
    "oxfmt": "^0.37.0",
    "oxlint": "^1.52.0",
    "tsx": "^4.7.0",
    "turbo": "^2.0.0",
    "typescript": "^5.3.0",
    "vitest": "^4.0.17"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "bun@1.3.10"
}
