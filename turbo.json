{
  "$schema": "https://turbo.build/schema.json",
  "envMode": "loose",
  "globalDependencies": ["bun.lock", "tsconfig.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "package.json", "tsconfig.json"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": ["NEXT_PUBLIC_*"]
    },
    "@project/web#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "package.json",
        "tsconfig.json",
        "next.config.mjs",
        "next-env.d.ts",
        "public/**"
      ],
      "outputs": [".next/**", "!.next/cache/**"],
      "env": ["NEXT_PUBLIC_*"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["*"]
    },
    "storybook": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["*"]
    },
    "@project/web#build-storybook": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        ".storybook/**",
        "package.json",
        "tsconfig.json",
        "next.config.mjs",
        "public/**"
      ],
      "outputs": ["storybook-static/**"],
      "env": ["NEXT_PUBLIC_*"]
    },
    "lint": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "../../.oxlintrc.json",
        "../../eslint-plugin-project/**",
        "../../node_modules/@fitzzero/quickdraw-core/oxlint.base.jsonc"
      ],
      "outputs": [],
      "cache": true
    },
    "lint:fix": {
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["src/**/*.ts", "src/**/*.tsx", "tsconfig.json"],
      "outputs": [],
      "cache": true
    },
    "@project/web#typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["src/**/*.ts", "src/**/*.tsx", "tsconfig.json", ".storybook/**"],
      "outputs": [],
      "cache": true
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "**/*.test.ts",
        "**/*.test.tsx",
        "vitest.config.ts",
        "vitest.int.config.ts"
      ],
      "outputs": [],
      "cache": true,
      "env": ["DATABASE_URL", "TEST_DATABASE_URL"]
    },
    "test:watch": {
      "cache": false,
      "persistent": true
    },
    "test:unit": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "**/*.test.ts", "vitest.config.ts"],
      "outputs": [],
      "cache": true
    },
    "test:int": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "**/*.test.ts", "vitest.int.config.ts", "../../packages/db/prisma/**"],
      "outputs": [],
      "cache": false,
      "env": ["DATABASE_URL", "TEST_DATABASE_URL", "JWT_SECRET"]
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "cache": false,
      "env": ["DATABASE_URL", "TEST_DATABASE_URL", "JWT_SECRET"]
    },
    "db:generate": {
      "cache": false,
      "env": ["DATABASE_URL"]
    },
    "db:push": {
      "cache": false,
      "env": ["DATABASE_URL"]
    },
    "db:migrate": {
      "cache": false,
      "env": ["DATABASE_URL"]
    },
    "db:seed": {
      "cache": false,
      "env": ["DATABASE_URL"]
    }
  }
}
