{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  // The template config: quickdraw-lint's base (the strict rule set and the
  // quickdraw plugin) plus the design-system rules. It updates with the package.
  "extends": ["./node_modules/@fitzzero/quickdraw-lint/oxlint.template.jsonc"],
  "plugins": ["typescript", "import", "react", "nextjs", "jsx_a11y"],
  "jsPlugins": [
    {
      "name": "project",
      "specifier": "./eslint-plugin-project/index.mjs"
    }
  ],
  "rules": {
    // A describe on every contract member (the MCP tools' descriptions, the
    // API docs): the base only warns, so that an upgrade never breaks lint
    "quickdraw/require-describe": "error"
  },
  "overrides": [
    {
      "files": ["**/src/bench/**", "**/apps/bench-web/**", "**/packages/bench/src/cli/**"],
      "rules": {
        "no-console": "off",
        "import/max-dependencies": "off",
        // the netcode bench's bots drive raw sockets on purpose, as a game client does
        "quickdraw/no-raw-socket": "off"
      }
    },
    {
      "files": ["**/apps/web/src/game/wire/**"],
      "rules": {
        // quickdraw-5.0 finding: the typed client has no React-free channel or event
        // API, and its stream one (holdStream, 5.1.4) needs a connection of its own,
        // so the game client's wire speaks the protocol's frames on the page's
        // socket itself (apps/web/src/game/wire/pageTransport.ts)
        "quickdraw/no-raw-socket": "off"
      }
    }
  ],
  "ignorePatterns": [
    "**/dist/**",
    "**/node_modules/**",
    "**/.turbo/**",
    "**/coverage/**",
    "**/.next/**",
    "**/next-env.d.ts",
    "**/storybook-static/**",
    "**/seed.ts",
    "scripts/**",
    "**/public/**"
  ]
}
