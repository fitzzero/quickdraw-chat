{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "import", "react", "nextjs", "jsx_a11y"],
  "categories": {
    "correctness": "deny",
    "suspicious": "deny",
    "pedantic": "deny"
  },
  "jsPlugins": [
    {
      "name": "quickdraw",
      "specifier": "@fitzzero/quickdraw-core/eslint-plugin"
    }
  ],
  "rules": {
    "react/rules-of-hooks": "error",
    "no-console": "error",
    "no-var": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/no-import-type-side-effects": "error",

    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/no-unsafe-argument": "error",
    "typescript/restrict-template-expressions": "off",
    "typescript/no-redundant-type-constituents": "off",

    "require-await": "error",
    "no-inline-comments": "error",
    "no-unmodified-loop-condition": "error",
    "no-promise-executor-return": "error",
    "eqeqeq": "error",
    "import/max-dependencies": ["error", { "max": 10 }],

    "complexity": ["error", { "max": 15 }],
    "max-depth": ["error", { "max": 4 }],
    "max-lines": ["error", { "max": 500, "skipBlankLines": true, "skipComments": true }],
    "max-lines-per-function": ["error", { "max": 80, "skipBlankLines": true, "skipComments": true }]
  },
  "overrides": [
    {
      "files": ["**/services/**/*.ts"],
      "rules": {
        "quickdraw/no-raw-service-room-string": "error",
        "quickdraw/no-cross-service-mutations": [
          "error",
          {
            "allowedModels": {
              "chat": ["chatMember"],
              "message": ["chat"]
            }
          }
        ],
        "quickdraw/require-zod-schema": "error",
        "quickdraw/no-service-method-record": "error",
        "quickdraw/no-unsafe-payload-cast": "error"
      }
    },
    {
      "files": ["apps/api/src/index.ts", "apps/api/src/auth/middleware.ts"],
      "rules": {
        "quickdraw/no-raw-service-room-string": "error"
      }
    },
    {
      "files": ["apps/web/**", "**/*.tsx"],
      "rules": {
        "typescript/explicit-function-return-type": "off",
        "jsx_a11y/no-autofocus": "off",
        "react/react-in-jsx-scope": "off",
        "import/no-unassigned-import": "off",
        "import/max-dependencies": "off",
        "max-lines-per-function": "off",
        "max-lines": "off",
        "no-warning-comments": "off",
        "quickdraw/no-raw-tooltip-strings": "error",
        "quickdraw/no-raw-typography-strings": "error",
        "quickdraw/no-raw-button-strings": "error",
        "quickdraw/no-raw-socket-on": "error",
        "quickdraw/no-raw-socket-emit": "error"
      }
    },
    {
      "files": ["packages/shared/**", "packages/db/**"],
      "rules": {
        "typescript/explicit-function-return-type": "error",
        "typescript/explicit-module-boundary-types": "error",
        "no-console": "error"
      }
    },
    {
      "files": ["**/__tests__/**", "**/*.test.ts", "**/*.test.tsx"],
      "rules": {
        "max-lines-per-function": "off",
        "max-lines": "off",
        "no-inline-comments": "off",
        "require-await": "off",
        "import/max-dependencies": "off"
      }
    }
  ],
  "ignorePatterns": [
    "**/dist/**",
    "**/node_modules/**",
    "**/.turbo/**",
    "**/coverage/**",
    "**/.next/**",
    "**/next-env.d.ts",
    "**/seed.ts",
    "scripts/**",
    "**/public/**"
  ]
}
