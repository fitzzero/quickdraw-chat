{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "schedule": ["before 6am on monday"],
  "timezone": "America/Los_Angeles",
  "labels": ["dependencies"],
  "prConcurrentLimit": 5,
  "rangeStrategy": "bump",
  "packageRules": [
    {
      "description": "Group all non-major updates into a single weekly PR",
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "all non-major dependencies",
      "groupSlug": "all-minor-patch"
    },
    {
      "description": "Shared Claude skills should always track latest — immediate PR, automerged when CI passes",
      "matchPackageNames": ["@rallycry/conveyor-skills"],
      "groupName": "conveyor-skills",
      "schedule": ["at any time"],
      "prPriority": 10,
      "automerge": true
    },
    {
      "description": "Framework updates get their own PR for visibility",
      "matchPackageNames": ["@fitzzero/quickdraw-core"],
      "groupName": "quickdraw-core",
      "labels": ["dependencies", "quickdraw-core"]
    },
    {
      "description": "Prisma pieces move together (client/adapter/CLI must stay in lockstep)",
      "matchPackageNames": [
        "prisma",
        "@prisma/client",
        "@prisma/adapter-pg",
        "pglite-prisma-adapter",
        "@electric-sql/pglite"
      ],
      "groupName": "prisma"
    },
    {
      "description": "Toolchain packages are declared in several workspaces. Group them so one PR moves every workspace at once and the versions cannot split across majors.",
      "matchPackageNames": ["vitest", "@vitest/coverage-v8", "typescript", "zod", "@types/node"],
      "groupName": "toolchain",
      "groupSlug": "toolchain"
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on monday"]
  },
  "vulnerabilityAlerts": {
    "labels": ["security"]
  }
}
