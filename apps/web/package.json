{
  "name": "@project/web",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p ${PORT:-3000}",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p ${PORT:-3000}",
    "lint": "oxlint -c ../../.oxlintrc.json .",
    "lint:fix": "oxlint --fix -c ../../.oxlintrc.json .",
    "typecheck": "tsgo --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "storybook": "storybook dev -p ${STORYBOOK_PORT:-6106} --host 0.0.0.0 --no-open",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@discord/embedded-app-sdk": "^2.5.0",
    "@emotion/cache": "^11.11.0",
    "@emotion/react": "^11.11.0",
    "@emotion/styled": "^11.11.0",
    "@fitzzero/quickdraw-core": "^4.1.0",
    "@mui/icons-material": "^7.0.0",
    "@mui/material": "^7.0.0",
    "@project/shared": "workspace:*",
    "@tanstack/react-query": "^5.20.0",
    "next": "^16.1.0",
    "next-intl": "^4.7.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "socket.io-client": "^4.7.4"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.5.0",
    "@storybook/addon-docs": "^10.5.0",
    "@storybook/nextjs-vite": "^10.5.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "^4.0.17",
    "jsdom": "^24.0.0",
    "storybook": "^10.5.0",
    "typescript": "^5.3.0",
    "vite": "^7.0.0",
    "vitest": "^4.0.17"
  }
}
