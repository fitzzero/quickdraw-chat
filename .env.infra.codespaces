# Checked-in infrastructure defaults for codespace / devcontainer contexts.
# scripts/load-env.sh prefers this file over .env.infra when CODESPACES=true,
# REMOTE_CONTAINERS is set, or /.dockerenv exists. Public URLs (CLIENT_URL,
# API_URL, redirect URIs) are derived dynamically from the codespace name by
# load-env.sh, so they are intentionally absent here.

# Database (created by .devcontainer/conveyor/setup.sh)
DATABASE_URL=postgresql://dev:dev@localhost:5432/quickdraw_chat

# Server — bind all interfaces so forwarded ports work
SERVER_IP=0.0.0.0
BACKEND_PORT=4000
FRONTEND_PORT=3000

# Dev auth (hard-blocked in production — the API refuses to boot)
ENABLE_DEV_CREDENTIALS=true
ENABLE_MOCK_OAUTH=true
NEXT_PUBLIC_ENABLE_MOCK_OAUTH=true

# Default service access for signed-in users without explicit grants
SERVICE_DEFAULT_ACCESS=userService:Read

LOG_LEVEL=info
