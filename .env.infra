# Checked-in infrastructure defaults for local development.
# Loaded (lowest precedence) by scripts/load-env.sh — real env vars and
# .env.local always win. Never put secrets here; use .env.local (gitignored).

# Database (matches docker-compose.yml)
DATABASE_URL=postgresql://dev:dev@localhost:5432/quickdraw_chat

# Server & URLs
SERVER_IP=localhost
BACKEND_PORT=4000
FRONTEND_PORT=3000
CLIENT_URL=http://localhost:3000
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# OAuth redirect URIs (local dev defaults; codespaces are derived dynamically)
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback
DISCORD_REDIRECT_URI=http://localhost:4000/auth/discord/callback

# Dev auth (hard-blocked in production — the API refuses to boot)
ENABLE_DEV_CREDENTIALS=true
ENABLE_MOCK_OAUTH=true
NEXT_PUBLIC_ENABLE_MOCK_OAUTH=true

# Default service access for signed-in users without explicit grants
SERVICE_DEFAULT_ACCESS=userService:Read

LOG_LEVEL=info
