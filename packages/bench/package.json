{
  "name": "@project/bench",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "compare": "tsx src/cli/compare.ts",
    "lint": "oxlint -c ../../.oxlintrc.json src",
    "lint:fix": "oxlint --fix -c ../../.oxlintrc.json src",
    "typecheck": "tsgo --noEmit",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@project/shared": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vitest": "^4.0.17"
  }
}
