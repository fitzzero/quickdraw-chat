// Prisma schema for quickdraw-based fullstack application
// Generated from @quickdraw/core patterns

generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// User & Authentication Models
// ============================================================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  // Whether a sign-in provider verified `email` for this user. Only a
  // verified address links a second provider or matches ADMIN_EMAILS; a
  // provider that did not verify its address gets a placeholder
  // (`<id>@<provider>.local`) instead (apps/api/src/auth/users.ts)
  emailVerified Boolean   @default(false) @map("email_verified")
  name          String?   @unique
  image         String?

  // Service-level access control: { "chatService": "Admin", "userService": "Read" }
  serviceAccess Json?     @map("service_access")

  // ── quickdraw-game:start ──
  // Guest sessions (anonymous game players) — see apps/api/src/auth/guest.ts
  isGuest       Boolean   @default(false) @map("is_guest")
  // ── quickdraw-game:end ──
  
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  
  // Relations
  accounts      Account[]
  sessions      Session[]
  chatMembers   ChatMember[]
  messages      Message[]
  documents     Document[]
  pushSubscriptions PushSubscription[]
  // ── quickdraw-game:start ──
  gameScores    GameScore[]
  // ── quickdraw-game:end ──

  @@map("users")
}

model Account {
  id                String   @id @default(cuid())
  userId            String   @map("user_id")
  provider          String   // "discord", "google"
  providerAccountId String   @map("provider_account_id")
  accessToken       String?  @map("access_token")
  refreshToken      String?  @map("refresh_token")
  expiresAt         Int?     @map("expires_at")
  tokenType         String?  @map("token_type")
  scope             String?
  
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  
  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

// A signed-in session, stored by the auth routes' SessionStore
// (apps/api/src/auth/sessions.ts). The session cookie carries a JWT naming the
// user and this row's id (`sid`); revoking the row signs the session out at
// once, whatever the JWT's own expiry.
model Session {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  // How the user signed in: "google", "discord", "mock", "guest", "discord-activity"
  provider  String
  // The sign-in request's User-Agent and IP, for a list of where a user is signed in
  userAgent String?  @map("user_agent")
  ip        String?
  expiresAt DateTime @map("expires_at")

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// ============================================================================
// Chat Models
// ============================================================================

// Chat uses a membership table (ChatMember) for access control.
// This is better than JSON ACL when you need to efficiently query:
// - "All chats user X can access"
// - "All members of chat Y"
// - Membership counts, etc.

model Chat {
  id        String   @id @default(cuid())
  title     String

  // The time of the chat's latest message, or its creation time before the
  // first one: maintained by messageService (postMessage moves it forward,
  // deleting the latest message moves it back), so the `myChats` collection
  // can order by it (a collection's order names columns only).
  lastMessageAt DateTime @default(now()) @map("last_message_at")

  // How many members (ChatMember rows) the chat has: what the `myChats` item
  // shows, so a list never reads a chat's members. Kept by each membership
  // write, in its transaction, through the tracked client (the lists holding
  // the chat get the new count); a deleted user's memberships, which the
  // database cascades, are counted out by a trigger (migration
  // 20261004200100_chat_member_count).
  memberCount Int @default(0) @map("member_count")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations - access control is managed via ChatMember table
  members   ChatMember[]
  messages  Message[]

  @@map("chats")
}

model ChatMember {
  id        String   @id @default(cuid())
  chatId    String   @map("chat_id")
  userId    String   @map("user_id")
  level     String   @default("Read") // "Read", "Moderate", "Admin"

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([chatId, userId])
  // A user's chats: what myChats opens and resumes from
  @@index([userId])
  @@map("chat_members")
}

// Access to a message is its chat's (messageService inherits it through
// chatId), plus Admin for its author (owner on userId), who may delete it.
model Message {
  id        String   @id @default(cuid())
  chatId    String   @map("chat_id")
  userId    String   @map("user_id")
  content   String
  role      String   @default("user") // "user", "assistant", "system"

  createdAt DateTime @default(now()) @map("created_at")
  
  // Relations
  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([chatId, createdAt])
  @@map("messages")
}

// ============================================================================
// Document Models - Example of simple JSON ACL pattern
// ============================================================================

// Documents use the built-in JSON ACL pattern (no membership table needed).
// This is simpler than Chat's membership table approach and works well when:
// - You don't need to query "all documents user X can access" efficiently
// - Access patterns are straightforward (owner + optional collaborators)
// - You want minimal schema complexity

model Document {
  id        String   @id @default(cuid())
  title     String
  content   String   @default("")
  ownerId   String   @map("owner_id")

  // Entry-level ACL stored as JSON array (same format as Chat.acl)
  // Format: [{ "userId": "...", "level": "Read" | "Moderate" | "Admin" }]
  // Unlike Chat, we use this directly instead of a membership table
  acl       Json?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@map("documents")
}

// ============================================================================
// Push Subscriptions - Web Push (PWA)
// ============================================================================

// One row per browser push endpoint. `endpoint` is globally unique so a
// re-subscribe upserts in place (and can move an endpoint between users if
// the browser profile switches accounts). Rows are pruned automatically when
// a push send returns 410/404 (endpoint expired or revoked).

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  endpoint  String   @unique
  p256dh    String
  auth      String

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

// ── quickdraw-game:start ──
// ============================================================================
// Game Models
// ============================================================================

// A game world (the demo ships one global world with a deterministic id —
// see GLOBAL_WORLD_ID in @project/shared). The row exists so the world gets
// quickdraw subscription/room semantics and an admin surface for free; the
// live simulation state is in-memory and never touches the database per tick.

model GameWorld {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  // The world's global chat (rendered as the in-game chat overlay)
  chatId    String?  @map("chat_id")
  // Optional world-specific config overrides (tunables come from definitions)
  config    Json?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  scores    GameScore[]

  @@map("game_worlds")
}

// Data-driven game content: tunables, items, spells — anything you'd
// otherwise bake into Godot .tres resources. Rows are served by
// DefinitionService (public read, admin write via the generic admin UI),
// fetched by both the server sim and the Godot client at load, so balance
// changes never require re-exporting the game.
model Definition {
  id        String   @id @default(cuid())
  // Namespace, e.g. "tunables", "items", "spells"
  type      String
  // Unique key within the type, e.g. "snake"
  key       String
  data      Json
  version   Int      @default(1)
  enabled   Boolean  @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([type, key])
  @@map("definitions")
}

// Persistent per-user score for a world. Written outside the tick loop
// (throttled upsert on death), read for leaderboards/profiles.
model GameScore {
  id         String   @id @default(cuid())
  worldId    String   @map("world_id")
  userId     String   @map("user_id")
  bestLength Int      @default(0) @map("best_length")

  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  world GameWorld @relation(fields: [worldId], references: [id], onDelete: Cascade)
  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([worldId, userId])
  @@map("game_scores")
}
// ── quickdraw-game:end ──
