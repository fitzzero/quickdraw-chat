{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "package.json",
        "tsconfig.json",
        "tsup.config.ts",
        "prisma/schema.prisma",
        "prisma/generated/**"
      ],
      "outputs": ["dist/**"]
    }
  }
}
