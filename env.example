# Environment layering (see scripts/load-env.sh):
#   1. .env.infra        — checked-in dev defaults (DB URL, ports, URLs, dev flags)
#   2. (secrets layer)   — optional secret-manager hook, see load-env.sh
#   3. .env.local        — your secrets & overrides (gitignored). Copy entries
#                          from this file into .env.local and fill them in.
# Real env vars (e.g. CI) always take precedence over all file layers.

# ============================================================================
# Secrets — belong in .env.local, never in .env.infra
# ============================================================================

# Auth (required in production; dev falls back to an insecure default)
JWT_SECRET=your-secret-key-change-in-production

# At-rest encryption for stored OAuth tokens (optional in dev).
# 64-char hex (32 bytes): generate with `openssl rand -hex 32`
ENCRYPTION_KEY=

# Bootstrap Admin (optional)
# Comma-separated emails auto-promoted to Admin on all services at sign-in
# Example: ADMIN_EMAILS=admin@example.com,owner@example.com
ADMIN_EMAILS=

# Google OAuth (optional — the mock OAuth flow covers local dev without it)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Discord OAuth (optional)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# ── quickdraw-game:start ──
# Discord Activity (Embedded App SDK) — same Discord application; the web
# client needs the id at build time. See apps/game/README.md → Discord Activity.
NEXT_PUBLIC_DISCORD_CLIENT_ID=
# ── quickdraw-game:end ──

# ============================================================================
# Overrides — defaults live in .env.infra; set here only to change them
# ============================================================================

# DATABASE_URL=postgresql://dev:dev@localhost:5432/quickdraw_chat

# Integration tests: PGlite (no PostgreSQL needed) is the default. Set
# TEST_DATABASE_URL to run them against real PostgreSQL instead (CI does this).
# TEST_DATABASE_URL=postgresql://dev:dev@localhost:5432/quickdraw_chat_test

# Database connection pool (Cloud Run/Lambda: 20/5; traditional VPS: 50/10)
# DB_POOL_MAX=20
# DB_POOL_MIN=5

# Extra CORS/redirect origins beyond CLIENT_URL (comma-separated)
# EXTRA_ALLOWED_ORIGINS=https://staging.example.com

# Cookie domain for cross-subdomain sessions in production
# COOKIE_DOMAIN=.example.com
